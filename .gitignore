.venv/
__pycache__/
*.pyc
*.csv
old
**/.DS_Store

# Local .terraform directories
**/.terraform/*

# .tfstate files (Contains sensitive infrastructure data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
# These often contain sensitive data like passwords or API keys.
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore plan output
# These can also contain sensitive data.
*tfplan*

# CLI configuration files
.terraformrc
terraform.rc
